# M5 Pomodoro v2 - Network Configuration TEMPLATE
#
# Copy this file to /config/network.ini on your SD card and edit the
# placeholders. The live network.ini is gitignored so your credentials
# don't get committed.
#
# Lines starting with # are comments (ignored)

[WiFi]
# Your WiFi network credentials
# REQUIRED: Edit these with your actual WiFi SSID and password
SSID=YourWiFiSSID
Password=YourWiFiPassword

# Optional fallback network (if primary WiFi unavailable)
# Uncomment and edit if you want a backup WiFi network
#SSID_Fallback=MobileHotspot
#Password_Fallback=FallbackPassword123

[MQTT]
# AWS IoT Core endpoint
# Find at: AWS Console > IoT Core > Settings > Device data endpoint
# Format: xxxxxxxxxxxxx-ats.iot.region.amazonaws.com
# REQUIRED for cloud sync: Replace with your actual endpoint
Broker=a3xxxxxxxxxx-ats.iot.us-east-1.amazonaws.com
Port=8883

# MQTT client ID (must be unique per device)
# Recommendation: Use m5-pomodoro-<last 6 hex of MAC address>
# You can find MAC address in serial monitor on boot
# Example: If MAC is 11:22:33:44:A1:B2, use m5-pomodoro-A1B2C3
ClientID=m5-pomodoro-XXXXXX

# MQTT keep-alive interval in seconds
KeepAlive=60

[Certificates]
# SSL/TLS certificate file paths (relative to SD card root)
# These files MUST exist for secure AWS IoT connection
# See config/certs/README.md for setup instructions
RootCA=/config/certs/AmazonRootCA1.pem
DeviceCert=/config/certs/device-certificate.pem.crt
PrivateKey=/config/certs/device-private.pem.key

[CloudSync]
# Enable or disable AWS IoT Device Shadow synchronization
# Set to false if you don't want cloud sync (device works offline)
Enabled=true

# Sync interval in minutes (how often to push statistics to cloud)
# Recommendations:
#   5 minutes = Performance mode (more frequent updates, more battery drain)
#   10 minutes = Balanced mode
#   30 minutes = Battery saver mode (less frequent updates, longer battery life)
SyncIntervalMin=5

[NTP]
# NTP server for time synchronization
# Used to update M5.Rtc (BM8563) when WiFi connects
# Default pool.ntp.org works worldwide
# You can use regional servers for faster sync:
#   time.nist.gov (USA)
#   time.google.com (Google)
#   pool.ntp.org (worldwide)
Server=pool.ntp.org

# --- Timezone configuration ---
# Two ways to set the clock; if both are provided, TimezoneOffset wins.
#
# 1) Timezone= (recommended for DST regions)
#    Any IANA tz name (Continent/City) -- the full ~470-entry database is
#    bundled via the TzDbLookup library, e.g.:
#      Europe/London, Europe/Belgrade, America/Los_Angeles, Asia/Tokyo,
#      Australia/Sydney, Pacific/Auckland, ...
#    Full list: https://github.com/nayarsystems/posix_tz_db/blob/master/zones.csv
#    A raw POSIX TZ string also works (e.g. "CET-1CEST,M3.5.0,M10.5.0/3").
#    DST transitions are encoded in the rules, so they happen automatically.
#    Lookups are case-insensitive. Bare "UTC" and "GMT" are also accepted.
# Timezone=Europe/London

# 2) TimezoneOffset= (legacy fixed offset, in seconds from UTC)
#    Wins over Timezone= if both are present. Examples:
#      0      = UTC
#      3600   = UTC+1   -18000 = UTC-5 (EST)
#      7200   = UTC+2   -21600 = UTC-6 (CST)
#     19800   = UTC+5:30 (IST)
#     32400   = UTC+9   (JST)
TimezoneOffset=0

# DST=true synthesizes EU-style DST (last Sun of Mar 02:00 -> last Sun of Oct
# 03:00) on top of TimezoneOffset. Ignored when Timezone= (named or POSIX)
# is used -- those already encode their own DST rules. Default: false.
DST=false

# ============================================================================
# Webhooks  (the generic integration path)
# ============================================================================
# On session events the device POSTs a small JSON body to each configured
# URL. Use this to plug into Telegram (via your own bot or a relay), Discord,
# Zapier, n8n, IFTTT, or any homemade script. Service-specific integrations
# (Toggl, Google Calendar, etc.) live in the server-side companion app and
# consume the MQTT device shadow (next firmware slice) -- not the firmware.
#
# Up to 4 webhooks are supported: [Webhook.1] .. [Webhook.4].
#
# Keys per webhook:
#   URL        Full https:// (or http://) endpoint. Required.
#   Events     Comma-separated event filter, or "*" for all. Default "*".
#              Supported events:
#                work_complete   work session timed out
#                break_complete  short or long break timed out
#                cycle_complete  full Pomodoro cycle finished
#   AuthHeader Optional Authorization header value (e.g. "Bearer xxx").
#   Format     Payload shape. Default "json". "telegram" emits Telegram's
#              own {chat_id, text} shape so no relay is needed.
#   ChatID     Required when Format=telegram. Your Telegram chat id.
#              Numeric (e.g. 123456789 for a personal chat, -1001234567890
#              for a supergroup) or "@channelname" for public channels.
#   Text       Message template (Format=telegram only). Placeholders are
#              substituted before sending:
#                {event}           e.g. "work_complete"
#                {duration_min}    minutes of the just-finished session
#                {session_number}  1-based work session inside the cycle
#                {total_sessions}  work sessions per cycle
#                {today}           completed work sessions today
#                {week}            rolling 7-day total
#                {device}          MQTT.ClientID
#              Empty Text= falls back to a sensible per-event default.
#
# Default JSON payload schema (Format=json, POST body, application/json):
#   {
#     "event": "work_complete",
#     "device": "<MQTT.ClientID>",
#     "timestamp": 1717612345,
#     "duration_min": 25,
#     "session_number": 3,
#     "total_sessions": 4,
#     "today": 5,
#     "week": 18
#   }
#
# Examples:
#
# [Webhook.1]
# URL=https://hooks.zapier.com/hooks/catch/12345/abcdef/
# Events=*
#
# [Webhook.2]
# URL=https://discord.com/api/webhooks/<ID>/<TOKEN>
# Events=work_complete,cycle_complete
#
# [Webhook.3]
# # Telegram bot. Get TOKEN from @BotFather; get CHAT_ID by messaging your
# # bot once then opening https://api.telegram.org/bot<TOKEN>/getUpdates and
# # finding "chat":{"id":<CHAT_ID>,...} in the JSON response.
# URL=https://api.telegram.org/bot<TOKEN>/sendMessage
# Format=telegram
# ChatID=<CHAT_ID>
# Events=work_complete,cycle_complete
# Text=Pomodoro {event}: session {session_number}/{total_sessions}, today {today}
